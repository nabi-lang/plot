//! The built-in font: Geist Regular, with Greek and some mathematical
//! symbols from Pretendard, as outlines in font units (glyphs.nabi,
//! generated by tools/font.py). The SVG backend uses only the advance
//! widths, to lay text out as a browser with Geist would; the
//! rasterizer fills the outlines.

mod glyphs;

use pkg::Path;
use pkg::path::{LINE, MOVE, QUAD};

// Close in the outline stream (the path's CLOSE is 4).
const END: u8 = 3;

/// Font units per em.
pub(pkg) const UNITS: f64 = glyphs::UNITS;
/// Ascender above the baseline, in ems.
pub(pkg) const ASCENT: f64 = glyphs::ASCENT / glyphs::UNITS;
/// Descender below the baseline, in ems (positive).
pub(pkg) const DESCENT: f64 = -glyphs::DESCENT / glyphs::UNITS;
/// Capital height, in ems.
pub(pkg) const CAP: f64 = glyphs::CAP / glyphs::UNITS;
/// Lowercase x height, in ems.
pub(pkg) const XHEIGHT: f64 = glyphs::XHEIGHT / glyphs::UNITS;

/// The glyph index of `c`, or `none` when the font lacks it.
pub(pkg) fn index(c: char) -> usize | none {
    let cp = c as u32;
    let lo = 0usize;
    let hi = glyphs::COUNT;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if glyphs::CODES[mid] < cp { lo = mid + 1; } else { hi = mid; }
    }
    if lo < glyphs::COUNT && glyphs::CODES[lo] == cp { lo } else { none }
}

/// Whether the font has a glyph for `c`.
///
/// ```nabi
/// assert(plot::font::covers('a') && plot::font::covers('\u{3b1}'));
/// assert(!plot::font::covers('\u{4e00}'));
/// ```
pub fn covers(c: char) -> bool { !(index(c) is none) }

// Missing glyphs are drawn as `?`.
fn glyph(c: char) -> usize {
    match index(c) {
        i: usize => i,
        none => index('?') ?? 0,
    }
}

// Widths of the Unicode spaces the font lacks, in ems.
fn space(c: char) -> f64 | none {
    match c {
        '\u{2002}' => 0.5,
        '\u{2003}' => 1.0,
        '\u{2004}' => 0.333,
        '\u{2005}' => 0.25,
        '\u{2006}' => 0.167,
        '\u{2009}' => 0.2,
        '\u{200a}' => 0.1,
        '\u{200b}' => 0.0,
        _ => none,
    }
}

/// The advance width of `c`, in ems.
pub(pkg) fn advance(c: char) -> f64 {
    if index(c) is none {
        if let w = space(c) { return w; }
    }
    (glyphs::ADVANCES[glyph(c)] as f64) / UNITS
}

/// The width of `s` set in the built-in font at `size` px.
///
/// ```nabi
/// let w = plot::font::width("Hello", 10.0);
/// assert(w > 20.0 && w < 40.0);
/// ```
pub fn width(s: str, size: f64) -> f64 {
    let w = 0.0;
    for c in s.chars() { w += advance(c); }
    w * size
}

/// Appends the outline of `c` with its origin (on the baseline) at
/// `(x, y)`, `size` px to the em; returns the advance in px.
pub(pkg) fn outline(p: Path, c: char, x: f64, y: f64, size: f64) -> f64 {
    if index(c) is none {
        if let w = space(c) { return w * size; }
    }
    let g = glyph(c);
    let k = size / UNITS;
    let i = glyphs::STARTS[g] as usize;
    let end = glyphs::STARTS[g + 1] as usize;
    while i < end {
        let op = glyphs::OUTLINES[i] as u8;
        if op == MOVE || op == LINE {
            let px = x + (glyphs::OUTLINES[i + 1] as f64) * k;
            let py = y - (glyphs::OUTLINES[i + 2] as f64) * k;
            if op == MOVE { p.move_to(px, py); } else { p.line_to(px, py); }
            i += 3;
        } else if op == QUAD {
            p.quad_to(
                x + (glyphs::OUTLINES[i + 1] as f64) * k,
                y - (glyphs::OUTLINES[i + 2] as f64) * k,
                x + (glyphs::OUTLINES[i + 3] as f64) * k,
                y - (glyphs::OUTLINES[i + 4] as f64) * k,
            );
            i += 5;
        } else {
            if op == END { p.close(); }
            i += 1;
        }
    }
    (glyphs::ADVANCES[g] as f64) * k
}
