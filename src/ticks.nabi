//! Tick locators. Linear axes use the extended Wilkinson algorithm
//! (Talbot, Lin and Hanrahan, "An Extension of Wilkinson's Algorithm for
//! Positioning Tick Labels on Axes", InfoVis 2010), as R's
//! `labeling::extended`; log axes put majors on powers of the base;
//! date axes pick a calendar unit (calendar.nabi).

use pkg::Scale;
use pkg::calendar;

const Q: [f64; 6] = [1.0, 5.0, 2.0, 2.5, 4.0, 3.0];
const W: [f64; 4] = [0.25, 0.2, 0.5, 0.05];
const EPS: f64 = 2.220446049250313e-14;

/// Nice tick values covering `[dmin, dmax]` with about `m` ticks, by
/// the extended Wilkinson search: the best weighted sum of simplicity
/// (steps 1, 5, 2, 2.5, 4, 3 times a power of ten, zero included),
/// coverage of the data range, density near `m` and legibility. The
/// result can reach past the range; `only_loose` makes it cover the
/// range. `O(m)` candidates a step size; the search stops by the
/// paper's bounds.
///
/// ```nabi
/// use plot::ticks::extended;
///
/// assert(extended(0.0, 100.0, 5) == [0.0, 25.0, 50.0, 75.0, 100.0]);
/// assert(extended(1.0, 10.0, 5) == [0.0, 2.5, 5.0, 7.5, 10.0]);
/// assert(extended(-3.7, 12.2, 7)[0] == -2.5);
/// ```
pub fn extended(dmin: f64, dmax: f64, m: usize, only_loose: bool = false) -> List<f64> {
    let (lo, hi) = if dmin > dmax { (dmax, dmin) } else { (dmin, dmax) };
    let m = m.max(2);
    if !(hi - lo >= EPS) || !lo.is_finite() || !hi.is_finite() {
        if !lo.is_finite() { return []; }
        return List::from_fn(m, |i| lo + (hi - lo) * (i as f64) / ((m - 1) as f64));
    }
    // Far from unit scale the scores overflow; search a scaled copy.
    let r = hi - lo;
    if r > 1e100 || r < 1e-100 {
        let k = 10.0 ** r.log10().floor();
        return search(lo / k, hi / k, m, only_loose).iter().map(|v| v * k).collect();
    }
    search(lo, hi, m, only_loose)
}

fn search(lo: f64, hi: f64, m: usize, only_loose: bool) -> List<f64> {
    let mf = m as f64;
    let best = -2.0;
    let bmin = lo;
    let bmax = hi;
    let bstep = hi - lo;
    let found = false;
    let j = 1.0;
    let done = false;
    // The bounds end the search; the caps only guard against NaN scores.
    while !done && j < 64.0 {
        for qi in 0..Q.len() {
            let q = Q[qi];
            let sm = simplicity_max(qi, j);
            if W[0] * sm + W[1] + W[2] + W[3] < best {
                done = true;
                break;
            }
            let k = 2.0;
            while k < 1000.0 {
                let dm = density_max(k, mf);
                if W[0] * sm + W[1] + W[2] * dm + W[3] < best { break; }
                let delta = (hi - lo) / (k + 1.0) / j / q;
                let z = delta.log10().ceil();
                let z_end = z + 40.0;
                while z < z_end {
                    let step = j * q * 10.0 ** z;
                    let cm = coverage_max(lo, hi, step * (k - 1.0));
                    if W[0] * sm + W[1] * cm + W[2] * dm + W[3] < best { break; }
                    let min_start = (hi / step).floor() * j - (k - 1.0) * j;
                    let max_start = (lo / step).ceil() * j;
                    let start = min_start;
                    while start <= max_start {
                        let lmin = start * (step / j);
                        let lmax = lmin + step * (k - 1.0);
                        let s = simplicity(qi, j, lmin, lmax, step);
                        let c = coverage(lo, hi, lmin, lmax);
                        let g = density(k, mf, lo, hi, lmin, lmax);
                        let score = W[0] * s + W[1] * c + W[2] * g + W[3];
                        if score > best && (!only_loose || (lmin <= lo && lmax >= hi)) {
                            best = score;
                            bmin = lmin;
                            bmax = lmax;
                            bstep = step;
                            found = true;
                        }
                        start += 1.0;
                    }
                    z += 1.0;
                }
                k += 1.0;
            }
        }
        j += 1.0;
    }
    if !found { return [lo, hi]; }
    let n = ((bmax - bmin) / bstep).round() as usize + 1;
    List::from_fn(n, |i| clean(bmin + (i as f64) * bstep, bstep))
}

fn simplicity(qi: usize, j: f64, lmin: f64, lmax: f64, lstep: f64) -> f64 {
    let n = Q.len() as f64;
    let r = lmin %% lstep;
    let v = if (r < EPS || lstep - r < EPS) && lmin <= 0.0 && lmax >= 0.0 { 1.0 } else { 0.0 };
    1.0 - (qi as f64) / (n - 1.0) - j + v
}

fn simplicity_max(qi: usize, j: f64) -> f64 {
    let n = Q.len() as f64;
    2.0 - (qi as f64) / (n - 1.0) - j
}

fn coverage(dmin: f64, dmax: f64, lmin: f64, lmax: f64) -> f64 {
    let r = dmax - dmin;
    1.0 - 0.5 * ((dmax - lmax) ** 2 + (dmin - lmin) ** 2) / ((0.1 * r) ** 2)
}

fn coverage_max(dmin: f64, dmax: f64, span: f64) -> f64 {
    let r = dmax - dmin;
    if span > r {
        let half = (span - r) / 2.0;
        1.0 - (half * half) / ((0.1 * r) ** 2)
    } else {
        1.0
    }
}

fn density(k: f64, m: f64, dmin: f64, dmax: f64, lmin: f64, lmax: f64) -> f64 {
    let r = (k - 1.0) / (lmax - lmin);
    let rt = (m - 1.0) / (lmax.max(dmax) - dmin.min(lmin));
    2.0 - (r / rt).max(rt / r)
}

fn density_max(k: f64, m: f64) -> f64 {
    if k >= m { 2.0 - (k - 1.0) / (m - 1.0) } else { 1.0 }
}

// Snap a multiple of `step` to the nearest value with no more digits
// than the step has, so 0.1 * 3 prints as 0.3.
fn clean(v: f64, step: f64) -> f64 {
    let d = -(step.abs().log10().floor()) + 2.0;
    if d <= 0.0 || d > 15.0 { return if v.abs() < step * 1e-9 { 0.0 } else { v }; }
    let p = 10.0 ** d;
    let r = (v * p).round() / p;
    if r == 0.0 { 0.0 } else { r }
}

/// The step of a run of evenly spaced ticks, 0 for fewer than two.
pub(pkg) fn step_of(ticks: List<f64>) -> f64 {
    if ticks.len() < 2 { 0.0 } else { (ticks[1] - ticks[0]).abs() }
}

/// Major and minor ticks for a view `[lo, hi]` on `scale`, about `m`
/// majors. Every tick returned lies in the view.
///
/// ```nabi
/// use plot::Scale;
/// use plot::ticks::locate;
///
/// let (major, minor) = locate(Scale::Log(10.0), 1.0, 1000.0, 5);
/// assert(major == [1.0, 10.0, 100.0, 1000.0]);
/// assert(minor.len() == 24);
/// ```
pub fn locate(scale: Scale, lo: f64, hi: f64, m: usize) -> (List<f64>, List<f64>) {
    let (a, b) = if lo <= hi { (lo, hi) } else { (hi, lo) };
    match scale {
        Log(base) => log_ticks(a, b, base, m),
        Symlog { base, linthresh } => symlog_ticks(a, b, base, linthresh, m),
        Date => (calendar::ticks(a, b, m), []),
        Linear => {
            let t = extended(a, b, m);
            (inside(t, a, b), linear_minor(t, a, b))
        }
    }
}

fn inside(t: List<f64>, a: f64, b: f64) -> List<f64> {
    let slack = (b - a).abs() * 1e-9;
    let step = step_of(t);
    if step == 0.0 { return t.iter().filter(|v| v >= a - slack && v <= b + slack).collect(); }
    // Extend the run of ticks across the whole view.
    let first = ((a - slack) / step).ceil();
    let last = ((b + slack) / step).floor();
    let n = last - first;
    if !(n >= 0.0) || n > 1000.0 { return t.iter().filter(|v| v >= a - slack && v <= b + slack).collect(); }
    List::from_fn(n as usize + 1, |i| clean((first + i as f64) * step, step))
}

fn linear_minor(t: List<f64>, a: f64, b: f64) -> List<f64> {
    let step = step_of(t);
    if step == 0.0 { return []; }
    // Four minors for a step of 1, 2 or 5 times 10^k is too many for 2:
    // matplotlib's AutoMinorLocator uses 4 for 1 and 5, 4 for 2, 5 for
    // 2.5.
    let mant = step / 10.0 ** step.log10().floor();
    let parts = if (mant - 2.5).abs() < 1e-9 || (mant - 5.0).abs() < 1e-9 { 5.0 } else { 4.0 };
    let sub = step / parts;
    let first = (a / sub).ceil();
    let last = (b / sub).floor();
    if !(last - first >= 0.0) || last - first > 5000.0 { return []; }
    let out: List<f64> = [];
    let v = first;
    while v <= last {
        let k = v / parts;
        if (k - k.round()).abs() > 1e-6 { out.push(clean(v * sub, sub)); }
        v += 1.0;
    }
    out
}

fn log_ticks(a: f64, b: f64, base: f64, m: usize) -> (List<f64>, List<f64>) {
    if !(a > 0.0) || !(b > 0.0) { return ([], []); }
    let lb = base.ln();
    let e0 = (a.ln() / lb - 1e-9).ceil();
    let e1 = (b.ln() / lb + 1e-9).floor();
    let decades = e1 - e0 + 1.0;
    if decades < 2.0 && base == 10.0 {
        // Less than two decades: 1, 2, 5 times powers of ten, or a
        // linear pick when even those are too sparse.
        let out: List<f64> = [];
        let e = (a.log10()).floor() - 1.0;
        while e <= b.log10().ceil() {
            for mult in [1.0, 2.0, 5.0] {
                let v = mult * 10.0 ** e;
                if v >= a * (1.0 - 1e-9) && v <= b * (1.0 + 1e-9) { out.push(v); }
            }
            e += 1.0;
        }
        if out.len() >= 3 { return (out, []); }
        return (inside(extended(a, b, m), a, b), []);
    }
    // Skip decades when there are too many to label.
    let every = ((decades / (m as f64)).ceil()).max(1.0);
    let major: List<f64> = [];
    let e = e0;
    while e <= e1 {
        if ((e - e0) %% every) == 0.0 { major.push(base ** e); }
        e += 1.0;
    }
    let minor: List<f64> = [];
    if every == 1.0 && base == 10.0 {
        let e = e0 - 1.0;
        while e <= e1 {
            for k in 2..10 {
                let v = (k as f64) * 10.0 ** e;
                if v >= a && v <= b { minor.push(v); }
            }
            e += 1.0;
        }
    }
    (major, minor)
}

fn symlog_ticks(a: f64, b: f64, base: f64, t: f64, m: usize) -> (List<f64>, List<f64>) {
    // Powers of the base outside the linear band, zero inside it.
    let out: List<f64> = [];
    let lb = base.ln();
    let ln_t = t.ln() / lb;
    let push_side = |sign: f64, lo: f64, hi: f64| -> List<f64> {
        let side: List<f64> = [];
        if hi <= t { return side; }
        let e0 = ((lo.max(t)).ln() / lb - 1e-9).ceil().max(ln_t.ceil());
        let e1 = (hi.ln() / lb + 1e-9).floor();
        let e = e0;
        while e <= e1 {
            side.push(sign * base ** e);
            e += 1.0;
        }
        side
    };
    if a < 0.0 {
        let neg = push_side(-1.0, (b.min(0.0)).abs(), a.abs());
        neg.reverse();
        for v in neg { out.push(v); }
    }
    if a <= 0.0 && b >= 0.0 { out.push(0.0); }
    if b > 0.0 {
        for v in push_side(1.0, a.max(0.0), b) { out.push(v); }
    }
    if out.len() > m + 2 {
        let every = (out.len() + m - 1) / m;
        let thin: List<f64> = [];
        let zero = out.iter().position(|v| v == 0.0) ?? 0;
        for i in 0..out.len() {
            let d = if i >= zero { i - zero } else { zero - i };
            if d % every == 0 { thin.push(out[i]); }
        }
        return (thin, []);
    }
    (out, [])
}
