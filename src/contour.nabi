//! Contours of a grid, by marching triangles: each cell splits along one
//! diagonal into two triangles over which the data is linear, so no
//! saddle is ambiguous. Lines cross each triangle in at most one
//! segment and join into polylines through the edges they share. Filled
//! bands clip the same triangles against the band's two levels
//! (Sutherland-Hodgman): an exact partition of the grid whose edges are
//! the lines; the pieces then merge into outlines (shared edges drop
//! out). Coordinates are in grid units: column, row.

/// Polylines (or polygons): piece `i` is the points
/// `starts[i]..starts[i + 1]` of `xy`.
///
/// ```nabi
/// let p = plot::contour::lines([0.0, 1.0, 0.0, 1.0], 2, 2, 0.5);
/// assert(p.starts.len() == p.len() + 1);
/// ```
#[derive(Clone, Debug)]
pub struct Pieces {
    pub xy: List<f64>;
    pub starts: List<usize>;
}

impl Pieces {
    fn new() -> Pieces { Pieces { xy: [], starts: [0] } }

    /// The number of pieces.
    ///
    /// ```nabi
    /// assert(plot::contour::lines([0.0, 0.0, 0.0, 0.0], 2, 2, 0.5).len() == 0);
    /// ```
    pub fn len(self) -> usize { self.starts.len() - 1 }

    fn end(self) { self.starts.push(self.xy.len() / 2); }
}

/// The contour lines of `z` (`rows` x `cols`, row-major) at `level`.
///
/// ```nabi
/// // A bump in the middle of a 3 x 3 grid: one closed ring.
/// let z = [0.0, 0.0, 0.0, 0.0, 2.0, 0.0, 0.0, 0.0, 0.0];
/// let p = plot::contour::lines(z, 3, 3, 1.0);
/// assert(p.len() == 1 && p.xy[0] == p.xy[p.xy.len() - 2]);
/// ```
pub fn lines(z: List<f64>, rows: usize, cols: usize, level: f64) -> Pieces {
    let out = Pieces::new();
    if rows < 2 || cols < 2 { return out; }
    // Segments as pairs of edge ids, and the point on each edge.
    let seg_a: List<usize> = [];
    let seg_b: List<usize> = [];
    let pts: Dict<usize, (f64, f64)> = Dict::new();
    for r in 0..rows - 1 {
        for c in 0..cols - 1 {
            let za = z[r * cols + c];
            let zb = z[r * cols + c + 1];
            let zc = z[(r + 1) * cols + c + 1];
            let zd = z[(r + 1) * cols + c];
            if !(za == za && zb == zb && zc == zc && zd == zd) { continue; }
            let (cf, rf) = (c as f64, r as f64);
            // Triangles a-b-c and a-c-d; three edge ids per grid point:
            // right, up, diagonal.
            let h0 = 3 * (r * cols + c);
            let v1 = 3 * (r * cols + c + 1) + 1;
            let dg = 3 * (r * cols + c) + 2;
            let h2 = 3 * ((r + 1) * cols + c);
            let v0 = 3 * (r * cols + c) + 1;
            tri(seg_a, seg_b, pts, level, [cf, cf + 1.0, cf + 1.0], [rf, rf, rf + 1.0], [za, zb, zc], [h0, v1, dg]);
            tri(seg_a, seg_b, pts, level, [cf, cf + 1.0, cf], [rf, rf + 1.0, rf + 1.0], [za, zc, zd], [dg, h2, v0]);
        }
    }
    // Join: each edge id is shared by at most two segments.
    let at: Dict<usize, List<usize>> = Dict::new();
    for s in 0..seg_a.len() {
        for e in [seg_a[s], seg_b[s]] {
            if let l = at.get(e) { l.push(s); } else { at[e] = [s]; }
        }
    }
    let used: List<bool> = List::filled(seg_a.len(), false);
    // Open chains first, from an end that only one segment touches.
    for pass in 0..2 {
        for s0 in 0..seg_a.len() {
            if used[s0] { continue; }
            let start_edge = seg_a[s0];
            let other = seg_b[s0];
            if pass == 0 {
                let na = (at.get(seg_a[s0]) ?? []).len();
                let nb = (at.get(seg_b[s0]) ?? []).len();
                if na != 1 && nb != 1 { continue; }
                if na != 1 {
                    start_edge = seg_b[s0];
                    other = seg_a[s0];
                }
            }
            used[s0] = true;
            let p0 = pts[start_edge];
            out.xy.push(p0.0);
            out.xy.push(p0.1);
            let cur = other;
            loop {
                let p = pts[cur];
                out.xy.push(p.0);
                out.xy.push(p.1);
                if cur == start_edge { break; }
                let next: usize | none = none;
                for s in at.get(cur) ?? [] {
                    if !used[s] {
                        next = s;
                        break;
                    }
                }
                match next {
                    s: usize => {
                        used[s] = true;
                        cur = if seg_a[s] == cur { seg_b[s] } else { seg_a[s] };
                    }
                    none => break,
                }
            }
            out.end();
        }
    }
    out
}

// The segment where a triangle crosses `level`, if it does: between the
// two edges whose ends lie on either side.
fn tri(seg_a: List<usize>, seg_b: List<usize>, pts: Dict<usize, (f64, f64)>, level: f64, xs: List<f64>, ys: List<f64>, zs: List<f64>, ids: List<usize>) {
    let hit: List<usize> = [];
    for e in 0..3 {
        let (i, j) = (e, (e + 1) % 3);
        if (zs[i] >= level) != (zs[j] >= level) {
            hit.push(e);
            if !pts.contains_key(ids[e]) {
                // From the lower-left end, so both triangles at an edge
                // compute the same point.
                let (a, b) = if (xs[i], ys[i]) < (xs[j], ys[j]) { (i, j) } else { (j, i) };
                let t = (level - zs[a]) / (zs[b] - zs[a]);
                pts[ids[e]] = (xs[a] + t * (xs[b] - xs[a]), ys[a] + t * (ys[b] - ys[a]));
            }
        }
    }
    if hit.len() == 2 {
        seg_a.push(ids[hit[0]]);
        seg_b.push(ids[hit[1]]);
    }
}

/// Polygons covering where `lo <= z < hi` (`z <= hi` when `last`) on the
/// triangles' linear interpolant, merged into outlines with holes wound
/// the other way (fill nonzero).
///
/// ```nabi
/// let z = [0.0, 1.0, 0.0, 1.0];
/// let p = plot::contour::band(z, 2, 2, 0.0, 0.5, false);
/// assert(p.len() > 0);
/// ```
pub fn band(z: List<f64>, rows: usize, cols: usize, lo: f64, hi: f64, last: bool) -> Pieces {
    let out = Pieces::new();
    if rows < 2 || cols < 2 { return out; }
    for r in 0..rows - 1 {
        for c in 0..cols - 1 {
            let za = z[r * cols + c];
            let zb = z[r * cols + c + 1];
            let zc = z[(r + 1) * cols + c + 1];
            let zd = z[(r + 1) * cols + c];
            if !(za == za && zb == zb && zc == zc && zd == zd) { continue; }
            let mn = za.min(zb).min(zc.min(zd));
            let mx = za.max(zb).max(zc.max(zd));
            if mx < lo || mn > hi || (!last && mn >= hi) { continue; }
            let (cf, rf) = (c as f64, r as f64);
            if mn >= lo && (mx < hi || (last && mx <= hi)) {
                for v in [cf, rf, cf + 1.0, rf, cf + 1.0, rf + 1.0, cf, rf + 1.0] { out.xy.push(v); }
                out.end();
                continue;
            }
            clip_tri(out, [cf, cf + 1.0, cf + 1.0], [rf, rf, rf + 1.0], [za, zb, zc], lo, hi);
            clip_tri(out, [cf, cf + 1.0, cf], [rf, rf + 1.0, rf + 1.0], [za, zc, zd], lo, hi);
        }
    }
    merge(out)
}

fn clip_tri(out: Pieces, xs: List<f64>, ys: List<f64>, zs: List<f64>, lo: f64, hi: f64) {
    let (x1, y1, z1) = clip(xs, ys, zs, |v| v - lo);
    if x1.len() < 3 { return; }
    let (x2, y2, _) = clip(x1, y1, z1, |v| hi - v);
    if x2.len() < 3 { return; }
    for i in 0..x2.len() {
        out.xy.push(x2[i]);
        out.xy.push(y2[i]);
    }
    out.end();
}

// Joins polygons that share edges into their outlines: an edge met in
// both directions is inside and drops out; the rest chain into loops,
// holes wound the other way. Points on straight runs are dropped.
fn merge(p: Pieces) -> Pieces {
    let ids: Dict<(i64, i64), usize> = Dict::new();
    let px: List<f64> = [];
    let py: List<f64> = [];
    let edges: Dict<(usize, usize), bool> = Dict::new();
    for k in 0..p.len() {
        let s = p.starts[k];
        let e = p.starts[k + 1];
        let first = 0usize;
        let prev = 0usize;
        for i in s..e {
            let key = ((p.xy[2 * i] * 1e9).round() as i64, (p.xy[2 * i + 1] * 1e9).round() as i64);
            let id = match ids.get(key) {
                v: usize => v,
                none => {
                    px.push(p.xy[2 * i]);
                    py.push(p.xy[2 * i + 1]);
                    ids[key] = px.len() - 1;
                    px.len() - 1
                }
            };
            if i == s { first = id; } else { toggle(edges, prev, id); }
            prev = id;
        }
        if e > s { toggle(edges, prev, first); }
    }
    let next: Dict<usize, List<usize>> = Dict::new();
    let order: List<(usize, usize)> = [];
    for (u, v) in edges.keys() { order.push((u, v)); }
    order.sort_by(|a, b| if a.0 != b.0 { a.0.cmp(b.0) } else { a.1.cmp(b.1) });
    for (u, v) in order {
        if let l = next.get(u) { l.push(v); } else { next[u] = [v]; }
    }
    let out = Pieces::new();
    for (u0, _) in order {
        loop {
            let l = next.get(u0) ?? [];
            if l.is_empty() { break; }
            let loop_pts: List<usize> = [u0];
            let cur = l.pop() ?? u0;
            let guard = 0usize;
            while cur != u0 && guard < 10000000 {
                loop_pts.push(cur);
                let m = next.get(cur) ?? [];
                if m.is_empty() { break; }
                cur = m.pop() ?? u0;
                guard += 1;
            }
            let n = loop_pts.len();
            for i in 0..n {
                let a = loop_pts[(i + n - 1) % n];
                let b = loop_pts[i];
                let c = loop_pts[(i + 1) % n];
                let cross = (px[b] - px[a]) * (py[c] - py[b]) - (py[b] - py[a]) * (px[c] - px[b]);
                if cross.abs() < 1e-12 { continue; }
                out.xy.push(px[b]);
                out.xy.push(py[b]);
            }
            out.end();
        }
    }
    out
}

fn toggle(edges: Dict<(usize, usize), bool>, u: usize, v: usize) {
    if u == v { return; }
    if edges.contains_key((v, u)) { edges.remove((v, u)); } else { edges[(u, v)] = true; }
}

// Keeps the part of the polygon where f(z) >= 0.
fn clip(xs: List<f64>, ys: List<f64>, zs: List<f64>, f: fn(f64) -> f64) -> (List<f64>, List<f64>, List<f64>) {
    let ox: List<f64> = [];
    let oy: List<f64> = [];
    let oz: List<f64> = [];
    let n = xs.len();
    for i in 0..n {
        let j = (i + 1) % n;
        let fi = f(zs[i]);
        let fj = f(zs[j]);
        if fi >= 0.0 {
            ox.push(xs[i]);
            oy.push(ys[i]);
            oz.push(zs[i]);
        }
        if (fi >= 0.0) != (fj >= 0.0) {
            // Interpolate from the lower-left end, so the cells on both
            // sides of an edge compute the same point.
            let (a, b, fa, fb) = if (xs[i], ys[i]) < (xs[j], ys[j]) { (i, j, fi, fj) } else { (j, i, fj, fi) };
            let t = fa / (fa - fb);
            ox.push(xs[a] + t * (xs[b] - xs[a]));
            oy.push(ys[a] + t * (ys[b] - ys[a]));
            oz.push(zs[a] + t * (zs[b] - zs[a]));
        }
    }
    (ox, oy, oz)
}
