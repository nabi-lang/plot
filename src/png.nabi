//! PNG encoding (ISO/IEC 15948): 8-bit RGB, or RGBA when any pixel is
//! not opaque, each row filtered by the type with the smallest sum of
//! absolute values (the usual heuristic), compressed by the package's
//! own DEFLATE.

pub(pkg) mod deflate;

/// A PNG file of `width` x `height` pixels from RGBA bytes, top row
/// first.
///
/// ```nabi
/// let px: List<u8> = [255, 0, 0, 255, 0, 0, 255, 128];
/// let f = plot::png::encode(px, 2, 1);
/// assert(f[0] == 137 && f[1] == 80 && f[2] == 78 && f[3] == 71);
/// ```
pub fn encode(rgba: List<u8>, width: usize, height: usize) -> List<u8> {
    let n = width * height;
    let alpha = false;
    for i in 0..n.min(rgba.len() / 4) {
        if rgba[4 * i + 3] != 255 {
            alpha = true;
            break;
        }
    }
    let bpp = if alpha { 4usize } else { 3usize };
    let stride = width * bpp;
    let raw: List<u8> = List::filled((stride + 1) * height, 0u8);
    let prev: List<u8> = List::filled(stride, 0u8);
    let cur: List<u8> = List::filled(stride, 0u8);
    let trial: List<u8> = List::filled(stride, 0u8);
    let best: List<u8> = List::filled(stride, 0u8);
    for y in 0..height {
        let o = y * width * 4;
        if alpha {
            for i in 0..stride { cur[i] = rgba[o + i]; }
        } else {
            for x in 0..width {
                cur[3 * x] = rgba[o + 4 * x];
                cur[3 * x + 1] = rgba[o + 4 * x + 1];
                cur[3 * x + 2] = rgba[o + 4 * x + 2];
            }
        }
        let best_kind = 0u8;
        let best_cost = u64::MAX;
        for kind in 0..5 {
            let cost = filter(kind as u8, cur, prev, trial, bpp);
            if cost < best_cost {
                best_cost = cost;
                best_kind = kind as u8;
                for i in 0..stride { best[i] = trial[i]; }
            }
        }
        let r = y * (stride + 1);
        raw[r] = best_kind;
        for i in 0..stride { raw[r + 1 + i] = best[i]; }
        for i in 0..stride { prev[i] = cur[i]; }
    }
    let out: List<u8> = [137, 80, 78, 71, 13, 10, 26, 10];
    let ihdr: List<u8> = [];
    be32(ihdr, width as u32);
    be32(ihdr, height as u32);
    for v in [8u8, if alpha { 6u8 } else { 2u8 }, 0, 0, 0] { ihdr.push(v); }
    chunk(out, "IHDR", ihdr);
    chunk(out, "IDAT", deflate::zlib(raw));
    chunk(out, "IEND", []);
    out
}

// Filters `cur` into `out` with filter `kind`; the cost is the sum of
// the bytes as signed values.
fn filter(kind: u8, cur: List<u8>, prev: List<u8>, out: List<u8>, bpp: usize) -> u64 {
    let n = cur.len();
    let cost = 0u64;
    for i in 0..n {
        let a = if i >= bpp { cur[i - bpp] as i32 } else { 0 };
        let b = prev[i] as i32;
        let c = if i >= bpp { prev[i - bpp] as i32 } else { 0 };
        let x = cur[i] as i32;
        let pred = match kind {
            0 => 0,
            1 => a,
            2 => b,
            3 => (a + b) / 2,
            _ => paeth(a, b, c),
        };
        let v = ((x - pred) & 255) as u8;
        out[i] = v;
        cost += if v < 128 { v as u64 } else { (256 - (v as u32)) as u64 };
    }
    cost
}

/// The Paeth predictor.
pub(pkg) fn paeth(a: i32, b: i32, c: i32) -> i32 {
    let p = a + b - c;
    let pa = (p - a).abs();
    let pb = (p - b).abs();
    let pc = (p - c).abs();
    if pa <= pb && pa <= pc { a } else if pb <= pc { b } else { c }
}

fn be32(out: List<u8>, v: u32) {
    for s in [24u32, 16, 8, 0] { out.push(((v >> s) & 255) as u8); }
}

fn chunk(out: List<u8>, kind: str, data: List<u8>) {
    be32(out, data.len() as u32);
    let body: List<u8> = List::with_capacity(data.len() + 4);
    for c in kind.bytes() { body.push(c); }
    for v in data { body.push(v); }
    for v in body { out.push(v); }
    be32(out, crc32(body));
}

/// CRC-32 (ISO 3309, as PNG and zlib use) of `data`.
///
/// ```nabi
/// assert(plot::png::crc32("IEND".as_bytes().to_list()) == 0xae426082);
/// ```
pub fn crc32(data: List<u8>) -> u32 {
    let table: List<u32> = List::filled(256, 0);
    for n in 0..256 {
        let c = n as u32;
        for _k in 0..8 { c = if c & 1 != 0 { 0xedb88320 ^ (c >> 1) } else { c >> 1 }; }
        table[n] = c;
    }
    let crc = 0xffffffffu32;
    for b in data { crc = table[((crc ^ (b as u32)) & 255) as usize] ^ (crc >> 8); }
    crc ^ 0xffffffff
}
